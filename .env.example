# YAML opcional. Sem ORACLE_MCP_CONFIG o processo usa o padrão e estas variáveis.
# ORACLE_MCP_CONFIG=configs/config.example.yaml
ORACLE_MCP_ADDRESS=127.0.0.1:8080
ORACLE_MCP_PUBLIC_BASE_URL=https://mcp.exemplo.com
ORACLE_MCP_READ_TIMEOUT=15s
ORACLE_MCP_WRITE_TIMEOUT=30s
ORACLE_MCP_SQLITE_PATH=./data/identity.db
ORACLE_MCP_ACCESS_TOKEN_TTL=15m
ORACLE_MCP_REFRESH_TOKEN_TTL=168h
